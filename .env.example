# Set values locally; never place a real key in this example.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional shared override; leave blank to use the role defaults below.
NIM_MODEL=
# Optional role overrides take precedence over NIM_MODEL.
# Advisor default: nvidia/nemotron-3.5-lightning-30b-a3b
NIM_ASSISTANT_MODEL=
# Other role defaults: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NIM_USER_MODEL=
NIM_JUDGE_MODEL=
NIM_SUMMARY_MODEL=
# NGC dataset access is separate from NVIDIA inference access.
NGC_CLI_API_KEY=

# Optional LiteLLM proxy. Leave commented until its health check passes.
# LAB_PROXY_BASE_URL=http://127.0.0.1:4000/v1
# LAB_PROXY_API_KEY=<local-random-secret-at-least-24-characters>
# Proxy groups can override model/provider/endpoint independently:
# LAB_FIXED_MODEL=openai/nvidia/nemotron-3.5-lightning-30b-a3b
# LAB_FIXED_API_BASE=https://integrate.api.nvidia.com/v1
# LAB_FIXED_API_KEY=<provider-key>
# Repeat LAB_{SUPPORT,CAPABLE,EFFICIENT}_{MODEL,API_BASE,API_KEY} as needed.
# Switchyard requires two distinct CAPABLE/EFFICIENT models.

# Optional standalone guide configuration; these do not create services.
# LAB_OPENSHELL_IMAGE=citizen-learning-advisor:0.3.0
# LAB_OPENSHELL_WORKSPACE=default
# LAB_OPENSHELL_STATE_DIR=/absolute/path/to/local-openshell-store
# LAB_REPOSITORY_URL=https://github.com/your-org/your-repository

# Explicit Helix Platform connection. These settings do not start services.
# LAB_HELIX_URL=http://127.0.0.1:8080
# LAB_HELIX_WORKSPACE=persona-lab
# LAB_HELIX_TOKEN=<only-if-required-by-local-Platform>
# LAB_HELIX_REMOTE_URL=https://your-platform.example
# LAB_HELIX_REMOTE_WORKSPACE=persona-lab
# LAB_HELIX_REMOTE_TOKEN=<remote-Platform-token>
# Required only for explicit native recovery against that remote Platform.
# LAB_HELIX_REMOTE_EXECUTOR_CONFIG=/absolute/path/to/remote-executor-config.yaml
# LAB_DEPLOYMENT_GATEWAY_KEY=<separate-random-secret-at-least-24-characters>
# LAB_DEPLOYMENT_PREFERENCES_TOKEN=<another-distinct-random-secret>
# Bind the admission bridge only to the verified host interface reachable by
# your Platform. Never use a broad network bind as a convenience default.
# LAB_DEPLOYMENT_GATEWAY_HOST=127.0.0.1
# LAB_DEPLOYMENT_GATEWAY_PORT=8766

# Machine-local setup may also use ignored .private/v02-runtime.env.
# Existing shell and .env values take precedence over that optional file.
