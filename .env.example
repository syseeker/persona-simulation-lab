# Set values locally; never place a real key in this example.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional shared override; leave blank to use the role defaults below.
NIM_MODEL=
# Optional role overrides take precedence over NIM_MODEL.
# Advisor default: nvidia/nemotron-3.5-lightning-30b-a3b
NIM_ASSISTANT_MODEL=
# Other role defaults: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NIM_USER_MODEL=
NIM_JUDGE_MODEL=
NIM_SUMMARY_MODEL=
# NGC dataset access is separate from NVIDIA inference access.
NGC_CLI_API_KEY=
